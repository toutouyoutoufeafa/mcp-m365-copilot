# ============================================
# MCP M365 Copilot - Client Configuration
# ============================================
# 1. Remplir les valeurs ci-dessous
# 2. Renommer en .env
# 3. Lancer .\run-client.ps1

# --- Requis (créés via create-app-reg.ps1) ---
ENTRA_CLIENT_ID="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
ENTRA_TENANT_ID="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# --- Optionnel ---
ENTRA_REDIRECT_URI="http://localhost:8400"
ENTRA_ENABLE_WAM="true"
WORKSPACE_ROOT="C:\mcp-workspace"

# Activer les agents optionnels (true/false)
# PURVIEW_ACCOUNT_NAME="mon-purview-account"
# ENABLE_AUTOPILOT="true"
# ENABLE_DEFENDER="true"
# ENABLE_M365ADMIN="true"
# ENABLE_EXCHANGE="true"

# Log level: debug, info, warn, error
LOG_LEVEL="info"

# Port MCP (défaut 3000)
PORT=3000

# ============================================
# Scopes de base (toujours activés)
# User.Read, Files.Read, Team.ReadBasic.All, Channel.ReadBasic.All
# ============================================

# ============================================
# Scopes optionnels (décommenter selon besoin)
# Nécessitent admin consent dans le tenant client
# Correspondent aux flags -Enable* dans create-app-reg.ps1
# ============================================

# Purview (lecture catalog, policies, lineage)
# PURVIEW_SCOPES="PurviewDataPolicies.Read.All PurviewCatalog.Read.All PurviewAccounts.Read.All"

# Intune (lecture devices, config)
# INTUNE_SCOPES="DeviceManagementManagedDevices.Read.All DeviceManagementConfiguration.Read.All"

# Security/Defender (lecture alerts, incidents)
# SECURITY_SCOPES="SecurityEvents.Read.All Alert.Read.All"

# Autopilot (Windows Autopilot / Intune device enrollment)
# AUTOPILOT_SCOPES="DeviceManagementManagedDevices.Read.All DeviceManagementManagedDevices.ReadWrite.All DeviceManagementServiceConfig.Read.All DeviceManagementServiceConfig.ReadWrite.All DeviceManagementConfiguration.Read.All DeviceManagementConfiguration.ReadWrite.All"

# Defender (Microsoft Defender for Endpoint/Cloud)
# DEFENDER_SCOPES="SecurityEvents.Read.All Alert.Read.All Alert.ReadWrite.All ThreatIndicators.Read.All ThreatIndicators.ReadWrite.OwnedBy Vulnerability.Read.All Machine.Read.All Machine.ReadWrite.All"

# M365 Admin Center (Organization, Domains, ServiceHealth, Reports, Directory, Roles, Policies)
# M365ADMIN_SCOPES="Organization.Read.All Organization.ReadWrite.All Domain.Read.All Domain.ReadWrite.All ServiceHealth.Read.All Reports.Read.All Directory.Read.All Directory.ReadWrite.All Policy.Read.All Policy.ReadWrite.All RoleManagement.Read.All RoleManagement.ReadWrite.Directory"

# Exchange Online (Mail, MailboxSettings, Calendars, Groups)
# EXCHANGE_SCOPES="Mail.Read Mail.ReadWrite Mail.Send MailboxSettings.Read MailboxSettings.ReadWrite Calendars.Read Calendars.ReadWrite Contacts.Read Contacts.ReadWrite Group.Read.All Group.ReadWrite.All"

# eDiscovery / Audit (souvent Application-only, pas Delegated)
# EDISCOVERY_SCOPES="Ediscovery.Read.All"
# AUDIT_SCOPES="AuditLog.Read.All"